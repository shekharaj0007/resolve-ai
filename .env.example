# PostgreSQL from docker compose. Leave unset to try this URL, then fall back to SQLite.
# DATABASE_URL=postgresql+psycopg://resolve:resolve@localhost:5432/resolveai

# Force the local SQLite file at data/resolve.db
# USE_SQLITE=1

# auto | sentence-transformers | svd
EMBEDDER=auto

# Optional. When set, reply drafts go through an OpenAI-compatible chat API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
